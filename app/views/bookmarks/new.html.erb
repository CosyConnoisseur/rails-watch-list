<div class="container my-2">
<h1>Add a movie to this list: <%= @list.name %></h1>
<p>Mention why you're adding it!</p>

<%= simple_form_for [@list, @bookmark] do |f| %>
  <%= f.input :movie_id,
              as: :select,
              collection: Movie.all,
              label_method: :title,
              value_method: :id,
              prompt: "Choose a movie" %>

  <%= f.input :comment, placeholder: "Why are you adding this movie?" %>

  <%= f.button :submit, "Add Movie", class: "btn btn-primary" %>
<% end %>
<p><%= link_to "Return to list", list_path(@list), class: "btn btn-secondary mt-3" %></p>
<p><%= link_to "Return to home", lists_path, class: "btn btn-dark" %></p>

</div>
